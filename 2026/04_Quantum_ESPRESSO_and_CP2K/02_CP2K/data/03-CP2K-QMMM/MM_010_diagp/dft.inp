&DFT
  BASIS_SET_FILE_NAME QM_data/BASIS_MOLOPT
  POTENTIAL_FILE_NAME QM_data/GTH_POTENTIALS
  CHARGE 0
  MULTIPLICITY 1
  &MGRID
    COMMENSURATE TRUE
    NGRIDS 5
    CUTOFF 500
    REL_CUTOFF 50
    SKIP_LOAD_BALANCE_DISTRIBUTED T
  &END
  &QS
    METHOD GPW 
    EPS_DEFAULT 1.0E-12
    EXTRAPOLATION ASPC
    EXTRAPOLATION_ORDER 4
  &END
  &SCF                          
    SCF_GUESS RESTART
    MAX_SCF 50
    EPS_SCF 1.0E-4
    &OUTER_SCF
      MAX_SCF 30
      EPS_SCF 1.0E-4
    &END
    ADDED_MOS  400 
    CHOLESKY INVERSE 
    &SMEAR  ON 
      METHOD FERMI_DIRAC 
      ELECTRONIC_TEMPERATURE [K] 300 
    &END SMEAR 
    &DIAGONALIZATION 
      ALGORITHM STANDARD 
      &FILTER_MATRIX
      	COLLECTIVE_COMMUNICATION T
      	AUTO_CUTOFF_SCALE 0.5
      &END FILTER_MATRIX
    &END DIAGONALIZATION 
    &MIXING 
      METHOD  BROYDEN_MIXING
      ALPHA   0.3
#      BETA    1.5 
      NBROYDEN 8
    &END
  &END SCF
  &XC
    &XC_FUNCTIONAL PBE
    &END XC_FUNCTIONAL
    &VDW_POTENTIAL
      POTENTIAL_TYPE PAIR_POTENTIAL 
      &PAIR_POTENTIAL
        PARAMETER_FILE_NAME QM_data/dftd3.dat
        TYPE DFTD3
	CALCULATE_C9_TERM .TRUE.
	REFERENCE_C9_TERM .TRUE.
        REFERENCE_FUNCTIONAL PBE
        R_CUTOFF [angstrom] 15
      &END
    &END VDW_POTENTIAL
  &END XC
&END DFT

