@SET CUTOFF 14
@SET ALPHA 0.2659
@SET O_SPLINE 6

@SET MMRADIUS_SCALE 1

@include FF_data_18042018/setparameters.inp


&FORCE_EVAL
  METHOD QMMM
  @include dft.inp
  &MM
    &FORCEFIELD
      SHIFT_CUTOFF T
      IGNORE_MISSING_CRITICAL_PARAMS .TRUE.
      
      @include FF_data_18042018/bond_angle_dia.inp
      @include FF_data_18042018/bond_angle_wat.inp

      &NONBONDED
	@include FF_data_18042018/lj_dia_dia_dia_wat.inp
	@include FF_data_18042018/lj_gp_gp_gp_wat.inp
      &END NONBONDED

      &SPLINE
	EMAX_SPLINE 1E100
	UNIQUE_SPLINE T
      &END SPLINE
    &END FORCEFIELD

    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
      &EWALD
        EWALD_TYPE SPME
        ALPHA $ALPHA
	GMAX 45 39 61
	O_SPLINE $O_SPLINE
      &END EWALD
    &END POISSON
    &NEIGHBOR_LISTS
      GEO_CHECK F
      NEIGHBOR_LISTS_FROM_SCRATCH F
    &END NEIGHBOR_LISTS
  &END MM

  &SUBSYS
    &CELL
      #ABC [angstrom] 5*4.40070 2*9.42530 4*2.84520+18
      ABC [angstrom] 5*4.40070 2*9.42530 29.3808
      PERIODIC XYZ
      ALPHA_BETA_GAMMA 90 90 90
    &END CELL

    &TOPOLOGY
      CONN_FILE_FORMAT PSF
      CONN_FILE_NAME  MM_diagp_010_wat.psf
      COORD_FILE_NAME MM_diagp_010_wat_tran_6_402.pdb
      COORD_FILE_FORMAT PDB
      EXCLUDE_VDW 1-3
      EXCLUDE_EI 1-3
      DISABLE_EXCLUSION_LISTS T
    &END

    &KIND HT
      ELEMENT H
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND

    &KIND OT
      ELEMENT O
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

    @include QM_data/atom_kinds.inp

  &END SUBSYS
  
  &QMMM
    CENTER NEVER 
    ECOUPL GAUSS
    USE_GEEP_LIB 10
    &FORCEFIELD
      &NONBONDED

        &LENNARD-JONES
            ATOMS HT OT
            EPSILON [kcalmol] 0.0000013298
            SIGMA [angstrom]  4.2710913140
            RCUT [angstrom] 14.0
        &END

        &LENNARD-JONES
            ATOMS HT YO
            EPSILON [kcalmol] 0.0000013298
            SIGMA [angstrom]  4.2710913140
            RCUT [angstrom] 14.0
        &END
        &LENNARD-JONES
            ATOMS HT YS
            EPSILON [kcalmol] 0.0000013298
            SIGMA [angstrom]  4.2710913140
            RCUT [angstrom] 14.0
        &END

        &LENNARD-JONES
            ATOMS YH OT
            EPSILON [kcalmol] 0.0000013298
            SIGMA [angstrom]  4.2710913140
            RCUT [angstrom] 14.0
        &END
      &END
    &END

    &WALLS
      K 0.2
      TYPE QUADRATIC
      WALL_SKIN 2 2 2.5 
    &END WALLS

    &PERIODIC
      GMAX 1
      NGRIDS 17*2 13*2 21*2
      &MULTIPOLE OFF
      &END
      &POISSON
	PERIODIC XY
 	POISSON_SOLVER PERIODIC
	&EWALD
          EWALD_TYPE SPME
          ALPHA $ALPHA
	  GMAX 45 39 61
	  O_SPLINE $O_SPLINE
	&END EWALD
      &END POISSON
    &END PERIODIC

    &CELL
      ABC [angstrom] 5*4.40070 2*9.42530 22
      ALPHA_BETA_GAMMA 90 90 90
      PERIODIC XY
    &END CELL

    &MM_KIND HT
      RADIUS [angstrom] 0.31*$MMRADIUS_SCALE
    &END MM_KIND

    &MM_KIND OT
      RADIUS [angstrom] 0.68*$MMRADIUS_SCALE
    &END MM_KIND

    &MM_KIND YH
      RADIUS [angstrom] 0.15*$MMRADIUS_SCALE
    &END MM_KIND

    &MM_KIND YO
      RADIUS [angstrom] 0.68*$MMRADIUS_SCALE
    &END MM_KIND

    &MM_KIND YA
      RADIUS [angstrom] 0.535*$MMRADIUS_SCALE
    &END MM_KIND

    &MM_KIND YS
      RADIUS [angstrom] 0.68*$MMRADIUS_SCALE
    &END MM_KIND

    
    &QM_KIND YA
      MM_INDEX 4 8 12 16 20 24 28 32 36 40
      MM_INDEX 44 48 52 56 60 64 68 72 76 80
      MM_INDEX 84 88 92 96 100 104 108 112 116 120
      MM_INDEX 124 128 132 136 140 144 148 152 156 160
    &END QM_KIND

    &QM_KIND YH
      MM_INDEX 328 336 344 352 360 368 376 384 392 400
      MM_INDEX 408 416 424 432 440 448 456 464 472 480
      MM_INDEX 488 496 504 512 520 528 536 544 552 560
      MM_INDEX 568 576 584 592 600 608 616 624 632 640
    &END QM_KIND

    &QM_KIND YS
      MM_INDEX 327 335 343 351 359 367 375 383 391 399
      MM_INDEX 407 415 423 431 439 447 455 463 471 479
      MM_INDEX 487 495 503 511 519 527 535 543 551 559
      MM_INDEX 567 575 583 591 599 607 615 623 631 639
    &END QM_KIND

    &QM_KIND YO
      MM_INDEX 164 168 172 176 180 184 188 192 196 200
      MM_INDEX 204 208 212 216 220 224 228 232 236 240
      MM_INDEX 244 248 252 256 260 264 268 272 276 280
      MM_INDEX 284 288 292 296 300 304 308 312 316 320
    &END QM_KIND

    &QM_KIND CR
      MM_INDEX 641..643
    &END QM_KIND
    &QM_KIND HCMM
      MM_INDEX 648..652
    &END QM_KIND
    &QM_KIND HOCO
      MM_INDEX 644 646
    &END QM_KIND
    &QM_KIND HOR
      MM_INDEX 645 647 
    &END QM_KIND
    &QM_KIND OR
      MM_INDEX 653..657
    &END QM_KIND
    &QM_KIND O2CM
      MM_INDEX 658
    &END QM_KIND
    &QM_KIND PO4
      MM_INDEX 659
    &END QM_KIND

    &QM_KIND HT
      MM_INDEX 668 683 689 722 734 749 764 788 791 803
      MM_INDEX 824 833 842 854 863 872 893 902 911 914
      MM_INDEX 932 938 947 983 989 992 1037 1040 1046 1058
      MM_INDEX 1112 1127 1130 1145 1172 1178 1181 1205
      MM_INDEX 667 682 688 721 733 748 763 787 790 802
      MM_INDEX 823 832 841 853 862 871 892 901 910 913
      MM_INDEX 931 937 946 982 988 991 1036 1039 1045 1057
      MM_INDEX 1111 1126 1129 1144 1171 1177 1180 1204 
    &END QM_KIND

    &QM_KIND OT
      MM_INDEX 666 681 687 720 732 747 762 786 789 801
      MM_INDEX 822 831 840 852 861 870 891 900 909 912
      MM_INDEX 930 936 945 981 987 990 1035 1038 1044 1056
      MM_INDEX 1110 1125 1128 1143 1170 1176 1179 1203 
    &END QM_KIND
  &END QMMM

&END FORCE_EVAL

&GLOBAL
  PROJECT diagpMM010
  RUN_TYPE MD
  PRINT_LEVEL LOW
  PREFERRED_FFT_LIBRARY FFTW3
  WALLTIME 71:50:00
  FFTW_PLAN_TYPE PATIENT
  &DBCSR
    MM_DRIVER BLAS
  &END DBCSR
  PREFERRED_DIAG_LIBRARY ELPA
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE NVT
    STEPS 100000
    TIMESTEP 0.5
    TEMPERATURE 300
    TEMP_TOL 10
    &THERMOSTAT
      TYPE CSVR
      REGION DEFINED
      &CSVR
        TIMECON [fs] 10
      &END CSVR
      &DEFINE_REGION
        MM_SUBSYS ATOMIC
      &END
      &DEFINE_REGION
        QM_SUBSYS ATOMIC
      &END
    &END THERMOSTAT
   &PRINT
   &END PRINT
  &END MD
  &CONSTRAINT
    &FIXED_ATOMS
      #surrounding atoms
      LIST   4 8 16 24 32 40 164 172 180 188
      LIST 196 200 316 320 327 328 335 336 343 344
      LIST 359 360 375 376 391 392 567 568 575 576
	#second layer fixed
      LIST 44 48 52 56 60 64 68 72 76 80
      LIST 84 88 92 96 100 104 108 112 116 120
      LIST 204 208 212 216 220 224 228 232 236 240
      LIST 244 248 252 256 260 264 268 272 276 280
      LIST 407 408 415 416 423 424 431 432 439 440
      LIST 447 448 455 456 463 464 471 472 479 480
      LIST 487 488 495 496 503 504 511 512 519 520
      LIST 527 528 535 536 543 544 551 552 559 560
      # third layer fixed	
      LIST 3 7 11 15 19 23 27 31 35 39
      LIST 123 127 131 135 139 143 147 151 155 159
      LIST 163 167 171 175 179 183 187 191 195 199
      LIST 283 287 291 295 299 303 307 311 315 319
      LIST 325 326 333 334 341 342 349 350 357 358
      LIST 365 366 373 374 381 382 389 390 397 398
      LIST 565 566 573 574 581 582 589 590 597 598
      LIST 605 606 613 614 621 622 629 630 637 638
      #bottom layer fixed
      LIST 41 45 49 53 57 61 65 69 73 77
      LIST 81 85 89 93 97 101 105 109 113 117
      LIST 201 205 209 213 217 221 225 229 233 237
      LIST 241 245 249 253 257 261 265 269 273 277
      LIST 401 402 409 410 417 418 425 426 433 434
      LIST 441 442 449 450 457 458 465 466 473 474
      LIST 481 482 489 490 497 498 505 506 513 514
      LIST 521 522 529 530 537 538 545 546 553 554
    &END FIXED_ATOMS
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY 
      &EACH
	MD 10
      &END EACH
      FORMAT DCD
    &END TRAJECTORY
    &VELOCITIES ON
      &EACH
	MD 100
      &END EACH
      FORMAT DCD      
    &END VELOCITIES
    &FORCES ON
      &EACH
        MD 100
      &END EACH
      FORMAT DCD
    &END FORCES
    &RESTART ON
      &EACH
	MD 10
      &END EACH
      BACKUP_COPIES 5
      ADD_LAST NUMERIC
    &END RESTART
  &END PRINT
&END MOTION
  
# &EXT_RESTART
#    RESTART_FILE_NAME diagpBB010-1.restart
# &END EXT_RESTART

