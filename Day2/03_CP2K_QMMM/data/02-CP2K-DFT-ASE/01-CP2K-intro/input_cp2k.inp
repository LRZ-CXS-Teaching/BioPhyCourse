&FORCE_EVAL
  &DFT
    CHARGE 0
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    # https://manual.cp2k.org/trunk/methods/dft/cutoff.html
    &MGRID
      NGRIDS 5
      REL_CUTOFF 50
      CUTOFF 500
    &END MGRID
    # https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/DFT/QS.html
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION ASPC
    &END QS
    # https://manual.cp2k.org/trunk/CP2K_INPUT/FORCE_EVAL/DFT/SCF.html
    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-4
      MAX_SCF 50
      CHOLESKY INVERSE
      #IGNORE_CONVERGENCE_FAILURE
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
	    POTENTIAL_TYPE PAIR_POTENTIAL
	    &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3
	      CALCULATE_C9_TERM .TRUE.
	      REFERENCE_C9_TERM .TRUE.
          REFERENCE_FUNCTIONAL PBE
	    &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
      &CELL
         PERIODIC XYZ
         A  6  0  0
         B  0  6  0
         C  0  0  6
      ALPHA_BETA_GAMMA 90 90 90
      &END CELL
      &TOPOLOGY
       &CENTER_COORDINATES T
       &END
       #CONN_FILE_FORMAT PSF
       #CONN_FILE_NAME MM_goeOP_100_wat.psf
       COORD_FILE_NAME h3po4_e.xyz
       COORD_FILE_FORMAT XYZ
      &END
      &KIND O
         BASIS_SET SZV-MOLOPT-GTH
         POTENTIAL GTH-PBE
      &END KIND
      &KIND H
         BASIS_SET SZV-MOLOPT-GTH
         POTENTIAL GTH-PBE
      &END KIND
      &KIND P
         BASIS_SET SZV-MOLOPT-GTH
         POTENTIAL GTH-PBE
      &END KIND
   &END SUBSYS
&END FORCE_EVAL

&GLOBAL
  PROJECT_NAME Pwater-opt
  RUN_TYPE GEO_OPT
  PREFERRED_FFT_LIBRARY FFTW3
  PREFERRED_DIAG_LIBRARY SL
  PRINT_LEVEL LOW 
&END GLOBAL 

&MOTION 
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_FORCE 4.5E-004 
    MAX_DR    3.0E-003
    MAX_ITER 500
  &END
&END
